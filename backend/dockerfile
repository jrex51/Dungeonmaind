FROM python:3.12.1

# Set working directory
WORKDIR /app

# Install system-level dependencies (including ffmpeg)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code and environment file
COPY app ./app
COPY .env .

# Download and cache embedding model into /models
RUN mkdir -p /models && \
    python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2', cache_folder='/models')"
ENV SENTENCE_TRANSFORMERS_HOME=/models

# Pre-download WhisperX model
RUN mkdir -p /models/whisperx && \
    python -c "import whisperx; whisperx.load_model('base', language='en', device='cpu', compute_type='int8', download_root='/models/whisperx')"
ENV WHISPERX_MODELS_DIR=/models/whisperx

# For predownloading the alignment model
ENV TORCH_HOME=/models/torch_cache
RUN python -c "\
import torch; \
import torchaudio; \
from whisperx.alignment import load_align_model; \
load_align_model(language_code='en', device='cpu')"

# Expose the FastAPI port
EXPOSE 8000

# Run the app with Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]