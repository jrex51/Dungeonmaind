# syntax=docker/dockerfile:1
FROM python:3.12.1

# ---------------------------------------------------------
# Working directory
# ---------------------------------------------------------
WORKDIR /app

# ---------------------------------------------------------
# System dependencies
# ---------------------------------------------------------
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# Python tooling
# ---------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip wheel

# ---------------------------------------------------------
# PyTorch variant
#
# Default: CPU-compatible build.
# NVIDIA/GPU Compose can set TORCH_VARIANT=cuda.
# ---------------------------------------------------------
ARG TORCH_VARIANT=cpu

RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$TORCH_VARIANT" = "cuda" ]; then \
        pip install \
            torch==2.8.0 \
            torchvision==0.23.0 \
            torchaudio==2.8.0 \
            --index-url https://download.pytorch.org/whl/cu126; \
    else \
        pip install \
            torch==2.8.0 \
            torchvision==0.23.0 \
            torchaudio==2.8.0; \
    fi

# ---------------------------------------------------------
# Stable ML dependencies
# ---------------------------------------------------------
COPY requirements-ml.txt .

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-ml.txt

# ---------------------------------------------------------
# Whisper / Faster-Whisper runtime
#
# CUDA runtime package is installed only for GPU builds.
# ---------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --force-reinstall --no-deps ctranslate2==4.6.3 \
    && if [ "$TORCH_VARIANT" = "cuda" ]; then \
        pip install faster-whisper==1.2.1 nvidia-cudnn-cu12; \
    else \
        pip install faster-whisper==1.2.1; \
    fi

# CUDA paths are harmless on CPU builds when the directories do not exist.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:${LD_LIBRARY_PATH}

# ---------------------------------------------------------
# Model cache configuration
# ---------------------------------------------------------
RUN mkdir -p /models

ENV SENTENCE_TRANSFORMERS_HOME=/models
ENV WHISPERX_MODELS_DIR=/models/whisperx
ENV TORCH_HOME=/models/torch_cache
ENV TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

RUN mkdir -p \
    /models/whisperx \
    /models/torch_cache/hub/checkpoints

# ---------------------------------------------------------
# Pre-download SentenceTransformer model
# ---------------------------------------------------------
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2', cache_folder='/models')"

# ---------------------------------------------------------
# Pre-download WhisperX ASR model
#
# CPU is intentionally used during Docker BUILD.
# Runtime code can still select GPU when available.
# ---------------------------------------------------------
RUN python -c "import whisperx; whisperx.load_model('base', language='en', device='cpu', compute_type='int8', download_root='/models/whisperx')"

# ---------------------------------------------------------
# Pre-download English alignment model
# ---------------------------------------------------------
RUN python -c "import torch.hub; torch.hub.download_url_to_file('https://download.pytorch.org/torchaudio/models/wav2vec2_fairseq_base_ls960_asr_ls960.pth', '/models/torch_cache/hub/checkpoints/wav2vec2_fairseq_base_ls960_asr_ls960.pth', progress=True)"

# ---------------------------------------------------------
# Build-time version check
# ---------------------------------------------------------
RUN python -c "import torch, ctranslate2; print('PyTorch:', torch.__version__); print('PyTorch CUDA build:', torch.version.cuda); print('CUDA available:', torch.cuda.is_available()); print('cuDNN version:', torch.backends.cudnn.version()); print('CTranslate2:', ctranslate2.__version__)"

# ---------------------------------------------------------
# Application dependencies
#
# Changes here should leave all previous ML/model layers cached.
# ---------------------------------------------------------
COPY requirements.txt .

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt -c requirements-ml.txt \
    && pip check

# ---------------------------------------------------------
# Application source
#
# Keep source last so ordinary source changes invalidate
# only this final layer.
#
# Compose bind-mounts /app during development for hot reload.
# ---------------------------------------------------------
COPY app ./app

# ---------------------------------------------------------
# FastAPI
# ---------------------------------------------------------
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]