FROM ollama/ollama

# Download models at runtime into the persistent Ollama volume, not the image.
COPY run-ollama.sh /usr/local/bin/start-ollama.sh
# ZIP checkouts on Windows can have CRLF line endings.
RUN sed -i 's/\r$//' /usr/local/bin/start-ollama.sh
EXPOSE 11434
ENTRYPOINT ["/bin/bash", "/usr/local/bin/start-ollama.sh"]
CMD []
